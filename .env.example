# --- Database (Supabase Postgres connection string, pooled) ---
DATABASE_URL="postgresql://postgres:[password]@[project-ref].pooler.supabase.com:6543/postgres"

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# --- AI (OpenAI). App runs in demo mode with mock responses if unset. ---
OPENAI_API_KEY=""

# --- Payments (Razorpay Test Mode - Primary Integration) ---
# Exact server-side credentials for Razorpay orders API and cryptographic HMAC-SHA256 signature verification
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# Optional client-side public key (keyId is also safely provided to checkout by server)
# Note: RAZORPAY_KEY_SECRET must NEVER be prefixed with NEXT_PUBLIC_ or exposed to the client
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"

# --- Payments (Stripe legacy fallback) ---
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
