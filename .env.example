# --- Database (Supabase Postgres connection string, pooled) ---
DATABASE_URL="postgresql://postgres:[password]@[project-ref].pooler.supabase.com:6543/postgres"

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# --- AI (OpenAI). App runs in demo mode with mock responses if unset. ---
OPENAI_API_KEY=""

# --- Payments (Stripe). App runs in mock payment mode if unset. ---
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
